# Copy this file to .env (repo root) and edit it. .env is gitignored, never commit it.
# Read by the backend (pydantic-settings) and by docker compose.
# New settings are added here, with a comment, when the feature that needs them is built.

# Where the app runs: DEV | STAGE | PROD
#   DEV    your laptop: hot reload, debug logs, fake adapters allowed
#   STAGE  test server: production build, real adapters, test WhatsApp number
#   PROD   real server: production build, real adapters, no fake adapters
APP_ENV=DEV

# ---- Ports on your machine (docker compose) ---------------------------------
# DEV:          backend API + /docs on BACKEND_PORT, Vite dev server on FRONTEND_DEV_PORT
# STAGE / PROD: nginx serves the app and /api on FRONTEND_PORT (backend is not exposed)
BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
FRONTEND_PORT=80
