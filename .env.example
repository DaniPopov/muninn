# Copy this file to .env (repo root) and edit it. .env is gitignored, never commit it.
# Read by the backend (pydantic-settings) and by docker compose.
# New settings are added here, with a comment, when the feature that needs them is built.

# Where the app runs: DEV | STAGE | PROD
#   DEV    your laptop: hot reload, debug logs, fake adapters allowed
#   STAGE  test server: production build, real adapters, test WhatsApp number
#   PROD   real server: production build, real adapters, no fake adapters
APP_ENV=DEV

# Public domain the app is reached at, without https:// (no trailing slash).
# Used for the WhatsApp webhook URL, links and CORS. WhatsApp needs a public HTTPS domain,
# so in DEV use localhost, or a tunnel domain when testing webhooks.
#   DEV: localhost   STAGE: stage.muninn.example.com   PROD: muninn.example.com
APP_DOMAIN=localhost

# ---- LLM (ADR 0007) ----------------------------------------------------------
# Any server that speaks the OpenAI chat API: OpenAI, OpenRouter, Ollama, vLLM, ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Secret: put the real key in .env (gitignored), never in this file.
LLM_API_KEY=
# Optional: none | minimal | low | medium | high | xhigh | max. Sent only when set.
# OpenAI's GPT-6 models need "none" for tool calling over Chat Completions.
# Leave empty for servers that don't support it (Ollama, vLLM, ...).
LLM_REASONING_EFFORT=

# ---- WhatsApp via Twilio (first messaging adapter; code comes with the WhatsApp feature)
# From the Twilio console. Secret: the auth token goes in .env, never here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp-enabled sender, with the whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_PHONE_NUMBER=

# ---- ngrok (DEV only): public HTTPS URL for local webhooks -------------------
# From https://dashboard.ngrok.com. Secret. Tunnel settings are in ngrok.yml
# (copy ngrok.example.yml). When using the tunnel, set APP_DOMAIN to your ngrok domain.
NGROK_AUTHTOKEN=

# ---- Ports on your machine (docker compose) ---------------------------------
# DEV:          backend API + /docs on BACKEND_PORT, Vite dev server on DASHBOARD_DEV_PORT
# STAGE / PROD: nginx serves the app and /api on DASHBOARD_PORT (backend is not exposed)
BACKEND_PORT=8000
DASHBOARD_DEV_PORT=5173
DASHBOARD_PORT=80
